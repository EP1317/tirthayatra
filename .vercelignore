# Exclude tooling / Firebase CLI config / reports from the public static deploy.
# Keep vercel.json and Python build scripts available for Vercel buildCommand.
# Python sources are deleted after build (see vercel.json buildCommand).
.git
.tools
.cursor
.DS_Store
**/__pycache__
*.pyc
scripts/
*.md
*.jsonl
.gitignore
.vercelignore
firebase.json
firestore.rules
dast-report.json
requirements.txt
pyproject.toml
Makefile
.firebase/
firestore-debug.log
data/firebase-public.json
agent-transcripts/
.github/
