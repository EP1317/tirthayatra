rules_version = '2';
// TirthaYatra feedback — AdSense-safe: private inbox only, never public UGC.
// Deploy: Firebase Console → Firestore → Rules, or `firebase deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'TirthaYatraOnline@gmail.com'
        ];
    }

    function isValidCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'type', 'name', 'email', 'body', 'pageTitle', 'path', 'href', 'kind',
          'status', 'adminNote', 'createdAt', 'ua'
        ])
        && d.status == 'new'
        && d.adminNote == ''
        && d.type in [
          'correction', 'add-detail', 'highlight', 'tip', 'question', 'appreciation'
        ]
        && d.body is string
        && d.body.size() > 2
        && d.body.size() <= 1200
        && d.name is string
        && d.name.size() <= 60
        && d.email is string
        && d.email.size() <= 120
        && d.pageTitle is string
        && d.pageTitle.size() <= 200
        && d.path is string
        && d.path.size() > 0
        && d.path.size() <= 300
        && d.href is string
        && d.href.size() > 0
        && d.href.size() <= 500
        && d.kind is string
        && d.kind.size() <= 40
        && d.ua is string
        && d.ua.size() <= 180
        && d.createdAt is timestamp;
    }

    match /feedback/{docId} {
      // Anyone may submit a new note (contact-form style). Nothing is public-readable.
      allow create: if isValidCreate();

      // Only verified allowlisted Google accounts may list/read.
      allow read: if isAdmin();

      // Admins may only change triage fields — not rewrite visitor content via client.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminNote', 'updatedAt'])
        && request.resource.data.status in ['new', 'reviewed', 'done', 'spam']
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 500;

      allow delete: if isAdmin();
    }
  }
}
